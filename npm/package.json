{
  "name": "detent",
  "version": "0.1.0",
  "description": "Tactile dials, knobs and switches that behave like hardware, with synthesized sound and haptics: dependency-free web components, SwiftUI files, and an agent skill for Claude Code, Codex, Cursor, Gemini CLI, GitHub Copilot, Windsurf and other coding agents.",
  "license": "MIT",
  "author": "Puru Sharma",
  "homepage": "https://detent-gamma.vercel.app",
  "repository": {
